<?xml version="1.0"?>
<!-- 2D 激光雷达模块：装在车体顶部，用于 SLAM 建图和导航避障 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_laser">

    <xacro:macro name="laser_link" params="parent xyz mass">
        <link name="laser_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder length="0.02" radius="0.02" />
                </geometry>
                <material name="black">
                    <color rgba="0.0 0.0 0.0 1.0" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder length="0.02" radius="0.02" />
                </geometry>
            </collision>
            <xacro:cylinder_inertia m="${mass}" r="0.02" h="0.02" />
        </link>
        <joint name="laser_joint" type="fixed">
            <parent link="${parent}" />
            <child link="laser_link" />
            <origin xyz="${xyz}" />
        </joint>
    </xacro:macro>

</robot>
