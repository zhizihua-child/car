<?xml version="1.0"?>
<!--
  Gazebo 控制插件（只定义宏，由总装配文件引用）
  - 让 Gazebo 里的小车能接收 /cmd_vel、发布 /odom 和 TF
  - 发布 /joint_states
  - 给各部件上色（Gazebo 不认 URDF 里的 material，要用 Gazebo/Material）
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="gazebo_control_plugin">

        <!-- ===== Gazebo 中的颜色 ===== -->
        <gazebo reference="base_link">
            <material>Gazebo/Blue</material>
        </gazebo>
        <gazebo reference="eye_link">
            <material>Gazebo/Black</material>
        </gazebo>
        <gazebo reference="left_wheel_link">
            <material>Gazebo/DarkGrey</material>
        </gazebo>
        <gazebo reference="right_wheel_link">
            <material>Gazebo/DarkGrey</material>
        </gazebo>
        <gazebo reference="odom_link">
            <material>Gazebo/Yellow</material>
        </gazebo>

        <!-- ===== 差速驱动 ===== -->
        <gazebo>
            <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
                <ros>
                    <namespace>/</namespace>
                    <remapping>cmd_vel:=cmd_vel</remapping>
                    <remapping>odom:=odom</remapping>
                </ros>
                <update_rate>30</update_rate>

                <!-- 左右驱动轮关节 -->
                <left_joint>left_wheel_joint</left_joint>
                <right_joint>right_wheel_joint</right_joint>

                <!-- 轮距（两轮中心距 0.2m）和轮径（半径 0.032m -> 直径 0.064m） -->
                <wheel_separation>0.2</wheel_separation>
                <wheel_diameter>0.064</wheel_diameter>

                <!-- 限幅 -->
                <max_wheel_torque>20</max_wheel_torque>
                <max_wheel_acceleration>1.0</max_wheel_acceleration>

                <!-- 输出：里程计 + TF（轮子的 TF 交给 robot_state_publisher 发，避免重复） -->
                <publish_odom>true</publish_odom>
                <publish_odom_tf>true</publish_odom_tf>
                <publish_wheel_tf>false</publish_wheel_tf>
                <odometry_frame>odom</odometry_frame>
                <robot_base_frame>base_link</robot_base_frame>
            </plugin>
        </gazebo>

        <!-- ===== 关节状态发布（把轮子转速发到 /joint_states） ===== -->
        <gazebo>
            <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
                <ros>
                    <namespace>/</namespace>
                    <remapping>joint_states:=joint_states</remapping>
                </ros>
                <update_rate>30</update_rate>
                <joint_name>left_wheel_joint</joint_name>
                <joint_name>right_wheel_joint</joint_name>
            </plugin>
        </gazebo>

        <!-- ===== 2D 激光雷达仿真 =====
             发布话题：/scan（sensor_msgs/LaserScan），360° 扫描，10Hz -->
        <gazebo reference="laser_link">
            <sensor name="laser" type="ray">
                <pose>0 0 0 0 0 0</pose>
                <visualize>true</visualize>
                <update_rate>10</update_rate>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>360</samples>
                            <resolution>1.0</resolution>
                            <min_angle>-3.14159</min_angle>
                            <max_angle>3.14159</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.12</min>
                        <max>8.0</max>
                        <resolution>0.015</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </ray>
                <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
                    <ros>
                        <namespace>/</namespace>
                        <remapping>~/out:=scan</remapping>
                    </ros>
                    <output_type>sensor_msgs/LaserScan</output_type>
                    <frame_name>laser_link</frame_name>
                </plugin>
            </sensor>
        </gazebo>

        <!-- ===== 摄像头仿真（装在眼睛上，朝车头正前方） =====
             发布话题：/camera/image_raw（图像）、/camera/camera_info（相机参数） -->
        <gazebo reference="eye_link">
            <sensor name="camera" type="camera">
                <pose>0.03 0 0 0 0 0</pose>
                <visualize>true</visualize>
                <update_rate>30</update_rate>
                <camera>
                    <horizontal_fov>1.047</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.05</near>
                        <far>15.0</far>
                    </clip>
                </camera>
                <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                    <ros>
                        <namespace>/</namespace>
                        <remapping>image_raw:=camera/image_raw</remapping>
                        <remapping>camera_info:=camera/camera_info</remapping>
                    </ros>
                    <camera_name>camera</camera_name>
                    <frame_name>eye_link</frame_name>
                </plugin>
            </sensor>
        </gazebo>

        <!-- ===== 碰撞检测（验收要求「全程碰撞次数少于 2 次」的客观依据） =====
             发布话题：/bumper_states（gazebo_msgs/ContactsState）
             仅统计车体（base_link_collision）的接触，不含轮子/万向轮与地面的正常接触 -->
        <gazebo reference="base_link">
            <sensor name="bumper" type="contact">
                <update_rate>20</update_rate>
                <contact>
                    <collision>base_link_collision</collision>
                </contact>
                <plugin name="bumper_controller" filename="libgazebo_ros_bumper.so">
                    <ros>
                        <namespace>/</namespace>
                    </ros>
                    <frame_name>base_link</frame_name>
                </plugin>
            </sensor>
        </gazebo>

    </xacro:macro>

</robot>
