    <!-- ===== 家具（嵌套模型，放在上层地板上）===== -->
    <!-- 咖啡桌：中心 (-3.0, -2.5)，底面 z=2.6（地板顶面） -->
    <include>
      <uri>model://cafe_table</uri>
      <name>cafe_table_1</name>
      <pose>-3.0 -2.5 2.6 0 0 0</pose>
    </include>

    <!-- 书架：靠后墙摆放，转 90 度 -->
    <include>
      <uri>model://bookshelf</uri>
      <name>bookshelf_1</name>
      <pose>2.0 -4.2 2.6 0 0 1.5708</pose>
    </include>

    <static>1</static>
